{
    "name": "webuild/theme-kit",
    "description": "Theme developer kit, contracts, registry, and workbench for Webuild portal themes",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "adilasomaaa",
            "homepage": "https://github.com/adilasomaaa"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4",
        "laravel/framework": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/view": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webuild\\ThemeKit\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Webuild\\ThemeKit\\ThemeKitServiceProvider"
            ]
        }
    }
}
